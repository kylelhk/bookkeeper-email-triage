# ============================================================
# Bookkeeper Email Triage API - environment settings
#
# HOW TO USE THIS FILE
# 1. Copy it to a new file named .env in the same folder:
#      macOS/Linux:  cp .env.example .env
#      Windows:      copy .env.example .env
# 2. Edit .env (NOT this file) and fill in your own values.
# 3. Restart the server after any change (uvicorn does not watch .env).
#
# .env is gitignored. Never commit real keys or tokens, and never put them in .env.example.
# ============================================================

# --- Required for every mode ---------------------------------
# Secret token that protects the API. Every request must send it as
#   Authorization: Bearer <token>
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the value as-is: no quotes, no spaces around "=".
API_TOKEN=replace-with-a-random-secret-token

# --- Which AI to use ------------------------------------------
# mock   = no AI and no API key needed. Fixed placeholder output, only for
#          checking the setup works.
# claude = real triage using the Anthropic (Claude) API. Fill in the Claude
#          section below.
# gemini = real triage using the Google Gemini API. Fill in the Gemini
#          section below.
PROVIDER=mock

# --- Claude settings (only needed if PROVIDER=claude) ---------
# Create a key in the Claude Console (API billing is separate from a claude.ai subscription).
ANTHROPIC_API_KEY=replace-with-your-claude-api-key
# claude-haiku-5-5 is the cheapest current model and suits batch scoring runs.
# For better quality, change it to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Gemini settings (only needed if PROVIDER=gemini) ---------
# Create a key in Google AI Studio. The free tier has small daily limits and can return 503 errors when demand is high.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
